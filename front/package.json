{
  "name": "eduos-maroc-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:api": "cd ../backend && .venv\\Scripts\\python.exe -m uvicorn eduos.main:app --app-dir src --reload --port 3001",
    "db:schema": "cd ../backend && .venv\\Scripts\\python.exe -m alembic upgrade head",
    "db:seed": "cd ../backend && .venv\\Scripts\\python.exe scripts/seed.py",
    "build": "next build",
    "start": "next start",
    "lint": "next lint"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "next": "15.1.0",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
